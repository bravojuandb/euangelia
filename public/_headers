# Cloudflare Pages reads this file from the build output and adds these
# headers to the responses whose path matches. Several rules can match one
# path; their headers add up.
# https://developers.cloudflare.com/pages/configuration/headers/

# Every page. The Content-Security-Policy lets only this site's own files
# load; Cloudflare Web Analytics, if it is turned on, adds a script from
# static.cloudflareinsights.com that reports to cloudflareinsights.com.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; font-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The favicon carries its own <style> (a lighter colour for dark themes),
# which the page's style-src 'self' would block: it gets a policy of its own
# that allows that style and nothing else.
/euangelia-ichtys.svg
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'

# Built files carry a hash of their contents in the name (index-B0f4zzPB.js):
# a new version gets a new name, so browsers may keep these for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The texts keep their names from one version to the next: an hour, after
# which the browser checks for a newer copy.
/data/*
  Cache-Control: public, max-age=3600

# The project's own pages.dev address stays out of search engines, so only
# the real domain is indexed (preview deployments are already left out).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
